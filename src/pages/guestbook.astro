---
// Not part of v1 (DECISIONS D9): removed from nav and Home, noindex, reachable by URL only.
// Entries are built with textContent (no innerHTML) to avoid stored XSS.
// Honeypot + rate limit + persistence are backend work (Lab 05 handoff) — not implemented here.
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout page="สมุดเยี่ยม" noindex>
  <section class="card">
    <h1>สมุดเยี่ยม</h1>
    <form id="gb-form">
      <label for="name">ชื่อ</label>
      <input id="name" name="name" required maxlength="80" />
      <label for="message">ข้อความ</label>
      <textarea id="message" name="message" rows="3" required maxlength="500"></textarea>
      <p style="margin-top:1rem"><button class="btn" type="submit">ฝากข้อความ</button></p>
      <p id="gb-status" role="status" aria-live="polite"></p>
    </form>
    <div id="entries" class="card" style="margin-top:1.25rem" aria-live="polite">กำลังโหลด…</div>
  </section>
</BaseLayout>
<script>
  type Entry = { name: string; message: string; created_at: string };
  const entries = document.getElementById('entries') as HTMLElement;
  const status = document.getElementById('gb-status') as HTMLElement;
  const form = document.getElementById('gb-form') as HTMLFormElement | null;
  const UNAVAILABLE = 'สมุดเยี่ยมยังไม่เปิดใช้งาน';

  function renderEntry(e: Entry): HTMLElement {
    const p = document.createElement('p');
    const name = document.createElement('strong');
    name.textContent = String(e.name ?? '');
    const small = document.createElement('small');
    small.textContent = String(e.created_at ?? '');
    p.append(name, document.createTextNode(`: ${String(e.message ?? '')}`), document.createElement('br'), small);
    return p;
  }

  async function load() {
    try {
      const res = await fetch('/api/guestbook');
      if (!res.ok) {
        entries.textContent = UNAVAILABLE;
        return;
      }
      const data = await res.json();
      const list: Entry[] = Array.isArray(data.entries) ? data.entries : [];
      if (!list.length) {
        entries.textContent = 'ยังไม่มีข้อความ';
        return;
      }
      entries.replaceChildren(...list.map(renderEntry));
    } catch {
      entries.textContent = UNAVAILABLE;
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(form).entries());
    try {
      const res = await fetch('/api/guestbook', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) {
        status.textContent = res.status === 400 ? 'ข้อมูลไม่ครบหรือไม่ถูกต้อง' : UNAVAILABLE;
        return;
      }
      status.textContent = 'ขอบคุณสำหรับข้อความ';
      form.reset();
      await load();
    } catch {
      status.textContent = UNAVAILABLE;
    }
  });
  load();
</script>
